<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>World Time: Kolkata and New York</title>
  <link rel="stylesheet" href="/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
</head>
<body>
  <main class="container">
    <header class="header">
      <h1>Global Clocks</h1>
      <p>Real-time updates for key locations.</p>
    </header>
    <div class="clocks-grid">
      <div class="clock-card">
        <h2 class="city-name">New York</h2>
        <div class="clock-display">
          <p class="time-main" id="us-time"><%= serverTimeUS %></p>
          <span class="seconds" id="us-seconds"></span>
        </div>
      </div>
      <div class="clock-card">
        <h2 class="city-name">Kolkata</h2>
        <div class="clock-display">
          <p class="time-main" id="india-time"><%= serverTimeIndia %></p>
          <span class="seconds" id="india-seconds"></span>
        </div>
      </div>
    </div>
  </main>
</body>
<script>
  const eventSource = new EventSource('/api/sse-time');

  eventSource.onmessage = function(event) {
    const data = JSON.parse(event.data);
    
    // Update main time (hours:minutes)
    document.getElementById('us-time').textContent = data.serverTimeUS.slice(0, 5);
    document.getElementById('india-time').textContent = data.serverTimeIndia.slice(0, 5);

    // Update seconds
    document.getElementById('us-seconds').textContent = data.serverTimeUS.slice(6, 8);
    document.getElementById('india-seconds').textContent = data.serverTimeIndia.slice(6, 8);
  };

  eventSource.onerror = function(err) {
    console.error('EventSource failed:', err);
    eventSource.close();
  };
</script>
</html>